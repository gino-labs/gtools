#!/usr/bin/env bash

# For alias to inherit tab completion
inherit_completion() {
  local src=$1
  local dest=$2

  local comp
  comp=$(complete -p "$src") || return 1
  eval "${comp% "$src"} $dest"
}

# Aliases
{% for ba in bash_aliases %}
alias {{ ba.alias }}='{{ ba.cmd }}'
{% if ba.complete %}
inherit_completion {{ ba.cmd.split()[0] }} {{ ba.alias }}
{% endif %}

{% endfor %}
